PORT=4001
ALLOWLIST_PATH=./data/allowlist.json
ADMIN_API_KEY=local-dev-secret-CHANGE-IN-PROD
LOG_LEVEL=info

# ─── Self-serve enrollment (testnet only) ──────────────────────────
# When enabled, exposes POST /self-serve/add — anyone can add their
# wallet to the Merkle tree, and the backend autonomously calls
# Compliance.updateRoot() to push the new root on-chain. Removes the
# admin-curl friction during a hackathon demo. Production deploys
# leave SELF_SERVE_ENABLED unset; only /admin/add (with x-api-key)
# remains, gated upstream
SELF_SERVE_ENABLED=false
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYMENT_PATH=../contracts/deployments/sepolia.json
# ADMIN_PRIVATE_KEY: must be admin of the Compliance contract (the EOA
# that called Compliance.transferAdmin most recently, or the deployer
# if untransferred). The backend signs Compliance.updateRoot from this
# key. Treat as sensitive — gitignored.
ADMIN_PRIVATE_KEY=
