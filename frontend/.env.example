# ─── Local Hardhat (default) ───────────────────────────────────────
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_COMPLIANCE_API_URL=http://127.0.0.1:4001
VITE_DEPLOYMENT_NETWORK=local

# ─── Sepolia (Phase 9 — uncomment when deployed) ───────────────────
# Switching VITE_DEPLOYMENT_NETWORK to "sepolia" enables the relayer
# SDK's production path (lazy-loaded `@zama-fhe/relayer-sdk/web`),
# enabling a real userDecrypt round-trip via Zama's KMS instead of
# the in-process mock that returns 0n.
#
# VITE_DEPLOYMENT_NETWORK=sepolia
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#
# Compliance backend must be hosted publicly with TLS (Render / Fly.io
# / Railway / your VPS). Update the URL below to match.
# VITE_COMPLIANCE_API_URL=https://compliance.your-domain.com
#
# WalletConnect projectId — required for mobile QR flow on Sepolia.
# Get one (free) at https://cloud.walletconnect.com. Without it, the
# wagmi config falls back to injected-only (browser extension wallets);
# the page still works but mobile-wallet users have no entry point.
# VITE_WC_PROJECT_ID=
