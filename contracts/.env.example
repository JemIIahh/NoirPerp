# Sepolia RPC. The default works; for higher rate limits use Alchemy or
# Infura. The user's verified URL is https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key (0x-prefixed). Use a NEW dedicated key, not your
# main wallet. Needs ~0.5 Sepolia ETH for the 8 contract deploys + ~6
# wiring txs. Fund via https://sepoliafaucet.com or
# https://www.alchemy.com/faucets/ethereum-sepolia
PRIVATE_KEY=

# Three relayer EOA addresses for the 2-of-3 oracle quorum. They must
# be funded separately (~0.1 Sepolia ETH each) since they sign every
# oracle tick (30s × 3 markets × 2 active relayers ≈ 17,280 txs / day).
# Relayer C stays offline (matches Phase 7's documented "C offline"
# deviation; quorum is satisfied by A+B alone). Private keys for A and B
# belong in oracle-relayer/.env, NOT here — this file only needs the
# addresses so deploy-sepolia.ts can register them on the Oracle.
RELAYER_A_ADDRESS=
RELAYER_B_ADDRESS=
RELAYER_C_ADDRESS=

# Etherscan API key for `npx hardhat verify --network sepolia ...`.
# Get one at https://etherscan.io/myapikey (free tier is fine).
ETHERSCAN_API_KEY=

# Optional: gas report on `npm test`. Leave false for normal runs.
REPORT_GAS=false
